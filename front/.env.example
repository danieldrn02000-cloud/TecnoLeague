# Configuración privada de Astro SSR; no usar prefijo PUBLIC_ ni VITE_.
BACKEND_GRAPHQL_URL=http://127.0.0.1:4000/graphql
AUTH_BRIDGE_SECRET=tecnoleague-local-astro-bridge-change-before-deploy
# En desarrollo dejar vacía: Astro reenvía el WebSocket por el mismo puerto 5173.
# En Netlify configurar BACKEND_GRAPHQL_URL=https://TU-BACKEND.onrender.com/graphql.
# El WebSocket se deduce automáticamente de esa URL. Esta variable es opcional,
# solo para un destino WebSocket distinto: wss://TU-BACKEND.onrender.com/graphql.
PUBLIC_BACKOFFICE_WS_URL=
