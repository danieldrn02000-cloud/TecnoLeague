---
import Layout from "../layouts/Layout.astro";

export const prerender = true;

const indice = [
  ["empezar", "1. Empieza por tus juegos"], ["componentes", "2. Las piezas de una PC"],
  ["ram", "3. RAM y generaciones DDR"], ["almacenamiento", "4. HDD, SSD y NVMe"],
  ["graficas", "5. Tarjetas gráficas"], ["marcas", "6. Quién hace qué"],
  ["consolas", "7. Consola o PC"], ["elegir", "8. Antes de comprar"], ["glosario", "9. Diccionario rápido"],
];
const piezas = [
  ["CPU · Procesador", "Ejecuta las instrucciones del juego y del sistema. Influye en la lógica, la física y la capacidad de mantener una partida fluida. Más núcleos o más GHz no bastan para comparar modelos de generaciones distintas."],
  ["GPU · Gráficos", "Dibuja lo que ves en pantalla. Su importancia crece al subir la resolución y la calidad gráfica. Puede venir integrada en el procesador o estar en una tarjeta dedicada."],
  ["RAM · Memoria de trabajo", "Mantiene a mano los datos que están utilizando el juego y las aplicaciones. Es rápida y temporal: pierde su contenido al apagar el equipo."],
  ["Almacenamiento", "Conserva tus juegos, archivos y sistema después de apagar la PC. Puede ser un disco duro HDD o una unidad SSD."],
  ["Placa madre", "Conecta todos los componentes. Determina qué procesadores, memorias, puertos y unidades puedes instalar; el tamaño también debe encajar en el gabinete."],
  ["Fuente y refrigeración", "La fuente alimenta el equipo; los ventiladores y disipadores retiran el calor. Calidad, conectores, potencia adecuada y ventilación importan tanto como las piezas más vistosas."],
];
const marcas = [
  ["AMD", "Diseña procesadores Ryzen y gráficos Radeon, además de chips personalizados para algunas consolas."],
  ["Intel", "Diseña procesadores Core y gráficos integrados y dedicados, como la familia Arc."],
  ["NVIDIA", "Diseña GPU como GeForce y tecnologías gráficas. Las tarjetas pueden venderse bajo su marca o mediante socios."],
  ["ASUS, MSI, Gigabyte y ASRock", "Ofrecen placas madre y tarjetas gráficas, entre otros productos. En las gráficas usan chips de proveedores como AMD, Intel o NVIDIA, según la marca y el modelo."],
  ["Samsung, SK hynix y Micron", "Son grandes fabricantes de chips de memoria. También participan en productos de almacenamiento y otros mercados."],
  ["Kingston, Corsair, G.Skill y ADATA", "Ofrecen módulos de RAM y, según la marca, SSD y otros accesorios. La marca del módulo no siempre es quien fabrica sus chips."],
  ["Seagate y Western Digital", "Son referentes del almacenamiento. Ofrecen productos como discos duros y distintas líneas de unidades de almacenamiento."],
  ["Sony, Microsoft y Nintendo", "Desarrollan las plataformas PlayStation, Xbox y Nintendo, con sus consolas, servicios y catálogos."],
];
const terminos = [
  ["FPS", "Fotogramas por segundo que genera el juego. Más FPS suelen dar una sensación de movimiento más fluida si el resto del equipo acompaña."],
  ["Hz", "Veces por segundo que el monitor puede actualizar la imagen. Un monitor de 144 Hz no hace que la PC genere automáticamente 144 FPS."],
  ["Resolución", "Cantidad de píxeles de la imagen: 1080p, 1440p y 4K son ejemplos. Más píxeles normalmente exigen más trabajo a la GPU."],
  ["VRAM", "Memoria para gráficos, habitualmente dedicada en una tarjeta gráfica. No equivale a la RAM del sistema; las GPU integradas suelen compartir parte de esta última."],
  ["GB y TB", "Unidades de capacidad. Sirven para hablar de RAM o espacio de almacenamiento, pero una misma capacidad no implica la misma velocidad."],
  ["MT/s", "Millones de transferencias por segundo: una medida habitual de la tasa de datos de la RAM DDR. No es lo mismo que la capacidad en GB."],
  ["Latencia y ping", "Tiempo de espera. El ping suele medir el viaje de datos por la red; un ping bajo ayuda en partidas en línea, pero no aumenta por sí solo los FPS."],
  ["Ray tracing", "Técnica para simular iluminación, reflejos y sombras. Puede aumentar mucho la carga gráfica; su rendimiento depende del juego y la GPU."],
  ["Reescalado", "Tecnologías como DLSS, FSR y XeSS reconstruyen una imagen de mayor resolución a partir de otra menor. Sus requisitos y resultados cambian según el juego y la versión."],
  ["Cuello de botella", "El componente o recurso que limita el rendimiento en una situación concreta. Cambia con el juego, la resolución y los ajustes; no existe un porcentaje universal para una PC."],
  ["Dual channel", "Uso de canales de memoria en paralelo cuando la plataforma y la instalación lo permiten. Hay que seguir el manual de la placa; comprar dos módulos no garantiza cualquier configuración."],
  ["RGB", "Iluminación de colores. Es una característica estética y no aumenta el rendimiento de un componente."],
];
---

<Layout title="Guía gamer para principiantes" description="Aprende qué son RAM, DDR5, SSD, NVMe y tarjetas gráficas. Compara PC y consolas y conoce las piezas antes de elegir tu equipo.">
  <a class="skip-link" href="#guia-contenido">Saltar a la guía</a>
  <header class="topbar">
    <div class="topbar-inner guide-topbar">
      <a class="brand" href="/" aria-label="TecnoLeague, volver a la tienda"><span class="logo"><img src="/images/logo.png" alt="TecnoLeague" /></span></a>
      <a class="text-btn" href="/">← Volver a la tienda</a>
    </div>
  </header>
  <main id="guia-contenido" class="gamer-guide">
    <section class="guide-hero" aria-labelledby="guide-title">
      <span class="eyebrow">TU PRIMERA PARTIDA EMPIEZA AQUÍ</span>
      <h1 id="guide-title">¿Eres nuevo en el mundo gamer?</h1>
      <p>No tienes que conocer todas las siglas para disfrutar de los videojuegos. Aprende qué hace cada pieza y elige tu equipo con más confianza, a tu ritmo.</p>
      <div class="guide-highlights"><span>Sin conocimientos previos</span><span>PC y consolas</span><span>Conceptos antes que marcas</span></div>
    </section>
    <div class="guide-layout">
      <nav class="guide-index panel" aria-label="Contenido de la guía">
        <h2>Explora la guía</h2>
        {indice.map(([id, texto]) => <a href={`#${id}`}>{texto}</a>)}
        <a class="guide-back" href="/">Volver a TecnoLeague →</a>
      </nav>
      <div class="guide-body">
        <section id="empezar" aria-labelledby="empezar-title">
          <span class="eyebrow">PRIMERO, LO QUE TE GUSTA</span>
          <h2 id="empezar-title">1. Empieza por los juegos que quieres jugar</h2>
          <p>Un juego de estrategia, una partida competitiva y una aventura con gráficos exigentes pueden necesitar equipos distintos. Antes de pensar en una marca, elige tus juegos, revisa sus requisitos y decide si jugarás en escritorio, sala o de viaje.</p>
          <div class="guide-note"><strong>Requisitos mínimos y recomendados:</strong> los mínimos suelen permitir ejecutar el juego bajo ciertas condiciones; no prometen calidad alta ni una tasa concreta de FPS. Comprueba la resolución y los ajustes a los que se refieren los recomendados.</div>
        </section>
        <section id="componentes" aria-labelledby="componentes-title">
          <h2 id="componentes-title">2. Las piezas de una PC trabajan en equipo</h2>
          <p>Piensa en la CPU como quien organiza el trabajo, la RAM como una mesa de trabajo y el almacenamiento como el lugar donde guardas todo. La GPU prepara las imágenes que terminarán en tu pantalla.</p>
          <div class="guide-cards">{piezas.map(([titulo, texto]) => <article class="panel guide-card"><h3>{titulo}</h3><p>{texto}</p></article>)}</div>
        </section>
        <section id="ram" aria-labelledby="ram-title">
          <h2 id="ram-title">3. RAM: capacidad, formato y generación</h2>
          <p>Más RAM ayuda cuando tus juegos y aplicaciones necesitan más memoria. Una vez cubierta esa necesidad, añadir capacidad por sí sola no garantiza más FPS. Para decidir, suma el uso del juego, el sistema y las aplicaciones que dejarás abiertas.</p>
          <div class="guide-cards">
            <article class="panel guide-card"><h3>DDR4 y DDR5</h3><p>Son generaciones de memoria RAM. DDR5 permite mayores tasas de transferencia y tiene una arquitectura diferente. DDR4 y DDR5 no son intercambiables: debes revisar la compatibilidad de la placa madre y el procesador.</p></article>
            <article class="panel guide-card"><h3>DIMM, SO-DIMM y memoria soldada</h3><p>DIMM es habitual en equipos de escritorio; SO-DIMM es común en laptops. Algunas laptops llevan memoria soldada que no puede ampliarse como un módulo. Revisa siempre el modelo exacto del equipo.</p></article>
          </div>
          <h3>¿Cuánta necesito?</h3>
          <p>16 GB pueden ser un punto de partida para muchos juegos; 32 GB pueden resultar útiles para títulos más exigentes, multitarea o creación de contenido. Son referencias, no requisitos universales: consulta tus juegos y tu presupuesto.</p>
          <p>Además de los GB, compara la tasa en MT/s, las latencias y la configuración de módulos. Perfiles como XMP o EXPO pueden requerir activación y compatibilidad; la velocidad anunciada no siempre es la que se obtiene de fábrica.</p>
        </section>
        <section id="almacenamiento" aria-labelledby="almacenamiento-title">
          <h2 id="almacenamiento-title">4. Disco duro y SSD: guardar no es lo mismo que trabajar</h2>
          <p>La RAM es temporal; el almacenamiento conserva tus archivos. Aunque a veces se llama «disco duro» a cualquier unidad, un HDD y un SSD funcionan de forma distinta.</p>
          <div class="guide-table-wrap" tabindex="0" role="region" aria-label="Comparación de almacenamiento">
            <table><thead><tr><th>Tipo</th><th>Qué es</th><th>Qué conviene saber</th></tr></thead><tbody>
              <tr><th scope="row">HDD</th><td>Disco con platos y piezas mecánicas.</td><td>Suele ofrecer mucha capacidad por su precio. Es más lento y sensible a golpes durante su funcionamiento. En cargas de juegos actuales puede quedarse corto.</td></tr>
              <tr><th scope="row">SSD SATA</th><td>Unidad de memoria flash que usa SATA.</td><td>Mejora mucho la respuesta frente a un HDD. Puede tener formato de 2.5 pulgadas o M.2, según el modelo.</td></tr>
              <tr><th scope="row">SSD NVMe</th><td>Unidad flash que usa el protocolo NVMe, normalmente sobre PCIe.</td><td>Ofrece mayores velocidades potenciales. Revisa qué generación PCIe y qué tamaño admite tu equipo; el uso real también influye.</td></tr>
              <tr><th scope="row">Unidad externa</th><td>HDD o SSD conectado, por ejemplo, mediante USB.</td><td>La velocidad depende tanto de la unidad como del puerto y el cable. No todos los juegos de consola pueden ejecutarse desde cualquier unidad externa.</td></tr>
            </tbody></table>
          </div>
          <div class="guide-note"><strong>M.2 no significa NVMe.</strong> M.2 describe un formato físico; existen unidades M.2 SATA y M.2 NVMe. Comprueba protocolo, longitud y ranura antes de comprar. Un SSD agiliza cargas y acceso a datos, pero no garantiza más FPS en todos los juegos.</div>
        </section>
        <section id="graficas" aria-labelledby="graficas-title">
          <h2 id="graficas-title">5. Gráficos integrados o tarjeta dedicada</h2>
          <div class="guide-cards">
            <article class="panel guide-card"><h3>Gráficos integrados</h3><p>Van dentro del procesador o del conjunto de chips y suelen compartir RAM. Pueden servir para juegos ligeros o competitivos con ajustes adecuados; su capacidad varía mucho entre modelos.</p></article>
            <article class="panel guide-card"><h3>Gráficos dedicados</h3><p>Disponen de un chip gráfico y habitualmente VRAM propia. En escritorio suelen ser una tarjeta independiente; en laptop normalmente forman parte del equipo y no se pueden cambiar como en una torre.</p></article>
          </div>
          <p>Las familias más conocidas incluyen NVIDIA GeForce, AMD Radeon e Intel Arc. No compares solo los GB de VRAM o el nombre comercial: consulta pruebas del modelo exacto en tus juegos y a la resolución que utilizarás.</p>
          <p>La VRAM puede usar tecnologías como GDDR6 o GDDR7; estas siglas no indican compatibilidad con los módulos DDR4 o DDR5 de tu placa madre. En una tarjeta de escritorio comprueba también tamaño, fuente, conectores y ventilación.</p>
          <div class="guide-note"><strong>Una laptop y una PC de escritorio no son equivalentes por compartir un nombre de GPU.</strong> La potencia disponible y la refrigeración pueden cambiar mucho el rendimiento.</div>
        </section>
        <section id="marcas" aria-labelledby="marcas-title">
          <h2 id="marcas-title">6. Quién hace qué: chips, componentes y marcas</h2>
          <p>Diseñar un chip, fabricarlo físicamente y vender una tarjeta o un módulo son tareas distintas. Por eso puedes encontrar una tarjeta de una marca que lleva una GPU diseñada por otra.</p>
          <div class="guide-table-wrap" tabindex="0" role="region" aria-label="Empresas y componentes">
            <table><thead><tr><th>Empresa o marca</th><th>En qué participa</th></tr></thead><tbody>{marcas.map(([marca, descripcion]) => <tr><th scope="row">{marca}</th><td>{descripcion}</td></tr>)}</tbody></table>
          </div>
          <p>También existen fabricantes especializados de chips, como TSMC, que producen para distintos diseñadores. Las empresas de la tabla son ejemplos; una marca puede tener productos excelentes y otros menos adecuados para tus necesidades. Compara cada modelo.</p>
        </section>
        <section id="consolas" aria-labelledby="consolas-title">
          <h2 id="consolas-title">7. Consolas, portátiles y PC</h2>
          <div class="guide-cards">
            <article class="panel guide-card"><h3>PlayStation</h3><p>La familia de Sony incluye PS5 y variantes como PS5 Pro. Revisa el catálogo, la versión concreta y si incorpora lector o requiere adquirirlo por separado. Las compras digitales y los discos no se gestionan igual.</p></article>
            <article class="panel guide-card"><h3>Xbox</h3><p>La familia de Microsoft incluye Series X y Series S. No tienen las mismas prestaciones ni todas las variantes admiten discos. Comprueba almacenamiento, juegos compatibles y condiciones de suscripción.</p></article>
            <article class="panel guide-card"><h3>Nintendo</h3><p>Switch y Switch 2 ofrecen propuestas de juego portátil y, según el modelo, conexión a un televisor. Revisa la compatibilidad de cada juego, los accesorios y las funciones concretas de la consola.</p></article>
            <article class="panel guide-card"><h3>PC y PC portátiles de mano</h3><p>Una torre permite elegir y actualizar muchas piezas. Una laptop prioriza movilidad. Equipos como Steam Deck son PC portátiles de mano: su sistema, los controles y la compatibilidad con juegos o antitrampas requieren revisión.</p></article>
          </div>
          <p>Las consolas suelen facilitar una experiencia más uniforme; una PC da más opciones de configuración. La mejor elección depende de tus juegos, presupuesto y amigos: confirma si hay juego cruzado entre plataformas. Una suscripción no siempre incluye todos los títulos ni los conserva disponibles para siempre.</p>
        </section>
        <section id="elegir" aria-labelledby="elegir-title">
          <h2 id="elegir-title">8. Tu lista antes de comprar</h2>
          <ol class="guide-checklist">
            <li><strong>Elige tus juegos y pantalla.</strong> Define si buscas jugar en 1080p, 1440p o 4K y qué fluidez te gustaría conseguir.</li>
            <li><strong>Cuenta el presupuesto completo.</strong> Incluye monitor, controles o teclado y ratón, audio, juegos y posibles suscripciones.</li>
            <li><strong>Comprueba compatibilidad.</strong> Procesador y placa, generación de RAM, ranuras de almacenamiento, espacio del gabinete y conexiones de la fuente.</li>
            <li><strong>Revisa pruebas y requisitos.</strong> Compara el modelo exacto en juegos similares. Un único número de rendimiento no describe todos los usos.</li>
            <li><strong>Valora calidad y soporte.</strong> Garantía, refrigeración, ruido y posibilidades de ampliación también cuentan. La certificación 80 PLUS habla de eficiencia energética, no garantiza por sí sola toda la calidad de una fuente.</li>
            <li><strong>Protege tu cuenta.</strong> Usa tiendas y controladores oficiales, contraseñas distintas y verificación en dos pasos. Mantén el sistema actualizado y revisa la clasificación de edad de los juegos.</li>
          </ol>
          <details class="guide-faq panel"><summary>¿Necesito el equipo más caro para empezar?</summary><p>No. Empieza por los requisitos de tus juegos y los ajustes que aceptas. Un equipo equilibrado para tu uso puede resultar más útil que gastar casi todo el presupuesto en una sola pieza.</p></details>
          <details class="guide-faq panel"><summary>¿Una buena conexión a internet sustituye una buena tarjeta gráfica?</summary><p>En un juego que se ejecuta en tu PC, la red y la GPU hacen trabajos diferentes. En juego por streaming, el servidor ejecuta el juego y la calidad de la conexión cobra más importancia; aun así necesitas un dispositivo y un servicio compatibles.</p></details>
          <details class="guide-faq panel"><summary>¿Todos los monitores y cables permiten la misma resolución y Hz?</summary><p>No. La GPU, el puerto, el cable y el monitor deben admitir la combinación deseada. Comprueba las especificaciones de cada conexión y activa la frecuencia adecuada en el sistema.</p></details>
        </section>
        <section id="glosario" aria-labelledby="glosario-title">
          <h2 id="glosario-title">9. Un diccionario para tu próxima compra</h2>
          <dl class="guide-glossary">{terminos.map(([termino, descripcion]) => <div><dt>{termino}</dt><dd>{descripcion}</dd></div>)}</dl>
        </section>
        <aside class="panel guide-finish"><h2>Ya conoces las piezas. Ahora piensa en tu partida.</h2><p>Vuelve a la tienda, compara las especificaciones y revisa la compatibilidad del modelo que te interese. Esta guía es un punto de partida: el rendimiento y los requisitos cambian con cada juego.</p><a class="btn" href="/">Explorar TecnoLeague →</a></aside>
      </div>
    </div>
  </main>
</Layout>
