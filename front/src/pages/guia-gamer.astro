---
import Layout from "../layouts/Layout.astro";
import { textosGuia, CONSULTA_GUIA, type GuiaGamer } from "../lib/guia-gamer";
import { requestBackend } from "../lib/server/graphql";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "no-store");

let guia: GuiaGamer | undefined;
try {
  const { body } = await requestBackend<{ guiaGamer: GuiaGamer }>({ query: CONSULTA_GUIA });
  guia = body.data?.guiaGamer;
} catch {
  // La guía original sigue disponible si el backend no responde.
}
const texto = textosGuia(guia);
const indice = ["empezar", "componentes", "ram", "almacenamiento", "graficas", "marcas", "consolas", "elegir", "glosario"];
const elementos = (seccion: string, cantidad: number) =>
  Array.from({ length: cantidad }, (_, i) => [
    texto(`${seccion}.elemento${i + 1}.titulo`),
    texto(`${seccion}.elemento${i + 1}.descripcion`),
  ]);
const piezas = elementos("componentes", 6);
const marcas = elementos("marcas", 8);
const terminos = elementos("glosario", 12);
---

<Layout title="Guía gamer para principiantes" description={texto("introduccion.descripcion")}>
  <a class="skip-link" href="#guia-contenido">Saltar a la guía</a>
  <header class="topbar">
    <div class="topbar-inner guide-topbar">
      <a class="brand" href="/" aria-label="TecnoLeague, volver a la tienda"><span class="logo"><img src="/images/logo.png" alt="TecnoLeague" /></span></a>
      <a class="text-btn" href="/">← Volver a la tienda</a>
    </div>
  </header>
  <main id="guia-contenido" class="gamer-guide">
    <section class="guide-hero" aria-labelledby="guide-title">
      <span class="eyebrow">{texto("introduccion.texto1")}</span>
      <h1 id="guide-title">{texto("introduccion.texto2")}</h1>
      <p>{texto("introduccion.texto3")}</p>
      <div class="guide-highlights"><span>{texto("introduccion.texto4")}</span><span>{texto("introduccion.texto5")}</span><span>{texto("introduccion.texto6")}</span></div>
    </section>
    <div class="guide-layout">
      <nav class="guide-index panel" aria-label="Contenido de la guía">
        <h2>Explora la guía</h2>
        {indice.map(id => <a href={`#${id}`}>{texto(`${id}.indice`)}</a>)}
        <a class="guide-back" href="/">Volver a TecnoLeague →</a>
      </nav>
      <div class="guide-body">
        <section id="empezar" aria-labelledby="empezar-title">
          <span class="eyebrow">{texto("empezar.texto1")}</span>
          <h2 id="empezar-title">{texto("empezar.texto2")}</h2>
          <p>{texto("empezar.texto3")}</p>
          <div class="guide-note"><strong>{texto("empezar.texto4")}</strong> {texto("empezar.texto5")}</div>
        </section>
        <section id="componentes" aria-labelledby="componentes-title">
          <h2 id="componentes-title">{texto("componentes.texto1")}</h2>
          <p>{texto("componentes.texto2")}</p>
          <div class="guide-cards">{piezas.map(([titulo, texto]) => <article class="panel guide-card"><h3>{titulo}</h3><p>{texto}</p></article>)}</div>
        </section>
        <section id="ram" aria-labelledby="ram-title">
          <h2 id="ram-title">{texto("ram.texto1")}</h2>
          <p>{texto("ram.texto2")}</p>
          <div class="guide-cards">
            <article class="panel guide-card"><h3>{texto("ram.texto3")}</h3><p>{texto("ram.texto4")}</p></article>
            <article class="panel guide-card"><h3>{texto("ram.texto5")}</h3><p>{texto("ram.texto6")}</p></article>
          </div>
          <h3>{texto("ram.texto7")}</h3>
          <p>{texto("ram.texto8")}</p>
          <p>{texto("ram.texto9")}</p>
        </section>
        <section id="almacenamiento" aria-labelledby="almacenamiento-title">
          <h2 id="almacenamiento-title">{texto("almacenamiento.texto1")}</h2>
          <p>{texto("almacenamiento.texto2")}</p>
          <div class="guide-table-wrap" tabindex="0" role="region" aria-label="Comparación de almacenamiento">
            <table><thead><tr><th>{texto("almacenamiento.texto3")}</th><th>{texto("almacenamiento.texto4")}</th><th>{texto("almacenamiento.texto5")}</th></tr></thead><tbody>
              <tr><th scope="row">{texto("almacenamiento.texto6")}</th><td>{texto("almacenamiento.texto7")}</td><td>{texto("almacenamiento.texto8")}</td></tr>
              <tr><th scope="row">{texto("almacenamiento.texto9")}</th><td>{texto("almacenamiento.texto10")}</td><td>{texto("almacenamiento.texto11")}</td></tr>
              <tr><th scope="row">{texto("almacenamiento.texto12")}</th><td>{texto("almacenamiento.texto13")}</td><td>{texto("almacenamiento.texto14")}</td></tr>
              <tr><th scope="row">{texto("almacenamiento.texto15")}</th><td>{texto("almacenamiento.texto16")}</td><td>{texto("almacenamiento.texto17")}</td></tr>
            </tbody></table>
          </div>
          <div class="guide-note"><strong>{texto("almacenamiento.texto18")}</strong> {texto("almacenamiento.texto19")}</div>
        </section>
        <section id="graficas" aria-labelledby="graficas-title">
          <h2 id="graficas-title">{texto("graficas.texto1")}</h2>
          <div class="guide-cards">
            <article class="panel guide-card"><h3>{texto("graficas.texto2")}</h3><p>{texto("graficas.texto3")}</p></article>
            <article class="panel guide-card"><h3>{texto("graficas.texto4")}</h3><p>{texto("graficas.texto5")}</p></article>
          </div>
          <p>{texto("graficas.texto6")}</p>
          <p>{texto("graficas.texto7")}</p>
          <div class="guide-note"><strong>{texto("graficas.texto8")}</strong> {texto("graficas.texto9")}</div>
        </section>
        <section id="marcas" aria-labelledby="marcas-title">
          <h2 id="marcas-title">{texto("marcas.texto1")}</h2>
          <p>{texto("marcas.texto2")}</p>
          <div class="guide-table-wrap" tabindex="0" role="region" aria-label="Empresas y componentes">
            <table><thead><tr><th>{texto("marcas.texto3")}</th><th>{texto("marcas.texto4")}</th></tr></thead><tbody>{marcas.map(([marca, descripcion]) => <tr><th scope="row">{marca}</th><td>{descripcion}</td></tr>)}</tbody></table>
          </div>
          <p>{texto("marcas.texto5")}</p>
        </section>
        <section id="consolas" aria-labelledby="consolas-title">
          <h2 id="consolas-title">{texto("consolas.texto1")}</h2>
          <div class="guide-cards">
            <article class="panel guide-card"><h3>{texto("consolas.texto2")}</h3><p>{texto("consolas.texto3")}</p></article>
            <article class="panel guide-card"><h3>{texto("consolas.texto4")}</h3><p>{texto("consolas.texto5")}</p></article>
            <article class="panel guide-card"><h3>{texto("consolas.texto6")}</h3><p>{texto("consolas.texto7")}</p></article>
            <article class="panel guide-card"><h3>{texto("consolas.texto8")}</h3><p>{texto("consolas.texto9")}</p></article>
          </div>
          <p>{texto("consolas.texto10")}</p>
        </section>
        <section id="elegir" aria-labelledby="elegir-title">
          <h2 id="elegir-title">{texto("elegir.texto1")}</h2>
          <ol class="guide-checklist">
            <li><strong>{texto("elegir.texto2")}</strong> {texto("elegir.texto3")}</li>
            <li><strong>{texto("elegir.texto4")}</strong> {texto("elegir.texto5")}</li>
            <li><strong>{texto("elegir.texto6")}</strong> {texto("elegir.texto7")}</li>
            <li><strong>{texto("elegir.texto8")}</strong> {texto("elegir.texto9")}</li>
            <li><strong>{texto("elegir.texto10")}</strong> {texto("elegir.texto11")}</li>
            <li><strong>{texto("elegir.texto12")}</strong> {texto("elegir.texto13")}</li>
          </ol>
          <details class="guide-faq panel"><summary>{texto("elegir.texto14")}</summary><p>{texto("elegir.texto15")}</p></details>
          <details class="guide-faq panel"><summary>{texto("elegir.texto16")}</summary><p>{texto("elegir.texto17")}</p></details>
          <details class="guide-faq panel"><summary>{texto("elegir.texto18")}</summary><p>{texto("elegir.texto19")}</p></details>
        </section>
        <section id="glosario" aria-labelledby="glosario-title">
          <h2 id="glosario-title">{texto("glosario.texto1")}</h2>
          <dl class="guide-glossary">{terminos.map(([termino, descripcion]) => <div><dt>{termino}</dt><dd>{descripcion}</dd></div>)}</dl>
        </section>
        <aside class="panel guide-finish"><h2>{texto("cierre.texto1")}</h2><p>{texto("cierre.texto2")}</p><a class="btn" href="/">{texto("cierre.texto3")}</a></aside>
      </div>
    </div>
  </main>
</Layout>
