{
  "name": "@tecnoleague/back",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts,graphql --exec ts-node src/main.ts",
    "build": "tsc -p tsconfig.json && node ../scripts/copy-schema.mjs",
    "start": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "db:repair-sequences": "ts-node prisma/repair-sequences.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "14.0.1",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/graphql": "14.0.1",
    "@nestjs/jwt": "12.0.1",
    "@nestjs/platform-express": "12.0.3",
    "@prisma/client": "6.19.3",
    "dotenv": "17.2.3",
    "graphql": "16.11.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.2.2",
    "mercadopago": "^3.6.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/ws": "^8.18.2",
    "nodemon": "3.1.11",
    "prisma": "6.19.3",
    "ts-node": "10.9.2",
    "ws": "^8.21.3"
  }
}
