generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Rol {
  ADMIN
  CLIENTE
}
enum EstadoPedido {
  PENDIENTE
  PAGADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  CANCELADO
  REEMBOLSADO
}

enum ProveedorPago {
  MERCADO_PAGO
  PAYPAL
}

enum TipoMovimientoInventario {
  INICIAL
  ENTRADA
  SALIDA
  AJUSTE
  PEDIDO
  CANCELACION
  RESERVA
  LIBERACION
}
model Categoria {
  id Int @id @default(autoincrement())
  nombre String @unique
  productos Producto[]
  @@map("categorias")
}
model Producto {
  id Int @id @default(autoincrement())
  nombre String
  descripcion String
  precio Decimal @db.Decimal(10, 2)
  imagen String
  stock Int
  marca String
  especificaciones String
  activo Boolean @default(true)
  stockMinimo Int @default(5) @map("stock_minimo")
  categoriaId Int @map("categoria_id")
  categoria Categoria @relation(fields: [categoriaId], references: [id])
  detalles DetallePedido[]
  movimientos MovimientoInventario[]
  intentos DetalleIntento[]
  @@index([categoriaId, activo])
  @@map("productos")
}
model Usuario {
  id Int @id @default(autoincrement())
  nombre String
  email String @unique
  passwordHash String? @map("password_hash")
  rol Rol @default(CLIENTE)
  pedidos Pedido[]
  intentos IntentoCompra[]
  movimientos MovimientoInventario[]
  cambiosPedido EventoEstadoPedido[]
  tokensRecuperacion TokenRecuperacion[]
  @@map("usuarios")
}
model Pedido {
  id Int @id @default(autoincrement())
  fecha DateTime @default(now())
  total Decimal @db.Decimal(12, 2)
  status EstadoPedido @default(PENDIENTE)
  nombre String
  email String
  direccion String
  metodoPago String @default("PAGO_AL_RECIBIR") @map("metodo_pago")
  claveSolicitud String @unique @map("clave_solicitud")
  huellaSolicitud String @map("huella_solicitud")
  usuarioId Int @map("usuario_id")
  usuario Usuario @relation(fields: [usuarioId], references: [id])
  detalles DetallePedido[]
  pagos Pago[]
  intento IntentoCompra?
  cambiosEstado EventoEstadoPedido[]
  movimientosInventario MovimientoInventario[]
  @@index([usuarioId, fecha])
  @@map("pedidos")
}
model DetallePedido {
  id Int @id @default(autoincrement())
  cantidad Int
  precioUnitario Decimal @db.Decimal(10, 2) @map("precio_unitario")
  nombreProducto String @map("nombre_producto")
  pedidoId Int @map("pedido_id")
  pedido Pedido @relation(fields: [pedidoId], references: [id])
  productoId Int @map("producto_id")
  producto Producto @relation(fields: [productoId], references: [id])
  @@index([pedidoId])
  @@map("detalle_pedido")
}

model EventoEstadoPedido {
  id Int @id @default(autoincrement())
  pedidoId Int @map("pedido_id")
  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  desde EstadoPedido?
  hacia EstadoPedido
  actorId Int @map("actor_id")
  actor Usuario @relation(fields: [actorId], references: [id], onDelete: Restrict)
  motivo String?
  creadoEn DateTime @default(now()) @map("creado_en")

  @@index([pedidoId, creadoEn])
  @@map("eventos_estado_pedido")
}

model MovimientoInventario {
  id Int @id @default(autoincrement())
  productoId Int @map("producto_id")
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  usuarioId Int? @map("usuario_id")
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  pedidoId Int? @map("pedido_id")
  pedido Pedido? @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  tipo TipoMovimientoInventario
  cantidad Int
  motivo String
  creadoEn DateTime @default(now()) @map("creado_en")

  @@index([productoId, creadoEn])
  @@index([pedidoId])
  @@map("movimientos_inventario")
}

model Pago {
  id Int @id @default(autoincrement())
  pedidoId Int? @map("pedido_id")
  pedido Pedido? @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  intentoId String? @unique @map("intento_id")
  intento IntentoCompra? @relation(fields: [intentoId], references: [id], onDelete: Restrict)
  proveedor ProveedorPago
  estado EstadoPago @default(PENDIENTE)
  monto Decimal @db.Decimal(12, 2)
  moneda String @default("MXN")
  idOrdenExterna String? @unique @map("id_orden_externa")
  idPagoExterno String? @unique @map("id_pago_externo")
  estadoProveedor String? @map("estado_proveedor")
  claveIdempotencia String @unique @map("clave_idempotencia")
  creadoEn DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")
  aprobadoEn DateTime? @map("aprobado_en")
  eventos EventoPago[]

  @@index([pedidoId])
  @@map("pagos")
}

model EventoPago {
  id Int @id @default(autoincrement())
  pagoId Int @map("pago_id")
  pago Pago @relation(fields: [pagoId], references: [id], onDelete: Restrict)
  claveEvento String @unique @map("clave_evento")
  tipo String
  estadoReportado String? @map("estado_reportado")
  recibidoEn DateTime @default(now()) @map("recibido_en")

  @@index([pagoId])
  @@map("eventos_pago")
}

model TokenRecuperacion {
  id Int @id @default(autoincrement())
  tokenHash String @unique @map("token_hash")
  usuarioId Int @map("usuario_id")
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEn DateTime @map("expira_en")
  usadoEn DateTime? @map("usado_en")
  creadoEn DateTime @default(now()) @map("creado_en")
  @@index([usuarioId])
  @@map("tokens_recuperacion")
}

// Un intento reserva existencias, pero no aparece en el historial de pedidos.
enum EstadoIntento {
  INICIADO
  EN_PROCESO
  CONFIRMADO
  RECHAZADO
  CANCELADO
  EXPIRADO
}

//Estados validados
enum ModalidadCheckout{
  REDIRECCION
  ORDERS_API
}

enum EstadoOperacionCobro{
  ENVIADA
  INCIERTA
  VINCULADA
  FINALIZADA
}

model IntentoCompra {
  id String @id @default(uuid())
  usuarioId Int @map("usuario_id")
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  claveSolicitud String @unique @map("clave_solicitud")
  huellaSolicitud String @map("huella_solicitud")
  nombre String
  email String
  direccion String
  total Decimal @db.Decimal(12, 2)
  moneda String @default("MXN")
  estado EstadoIntento @default(INICIADO)
  modalidad ModalidadCheckout @default(REDIRECCION)
  operaciones OperacionCobro[]
  pedidoId Int? @unique @map("pedido_id")
  pedido Pedido? @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  pago Pago?
  detalles DetalleIntento[]
  checkoutPayload Json? @map("checkout_payload")
  checkoutUrl String? @map("checkout_url")
  reservaActiva Boolean @default(true) @map("reserva_activa")
  expiraEn DateTime @map("expira_en")
  proximaRevision DateTime @default(now()) @map("proxima_revision")
  ultimoError String? @map("ultimo_error")
  creadoEn DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")
  @@index([estado, proximaRevision])
  @@index([usuarioId, creadoEn])
  @@map("intentos_compra")
}

model DetalleIntento {
  id Int @id @default(autoincrement())
  intentoId String @map("intento_id")
  intento IntentoCompra @relation(fields: [intentoId], references: [id], onDelete: Restrict)
  productoId Int @map("producto_id")
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  cantidad Int
  precioUnitario Decimal @db.Decimal(10, 2) @map("precio_unitario")
  nombreProducto String @map("nombre_producto")
  @@unique([intentoId, productoId])
  @@map("detalle_intento")
}

//Distinguir cada cobro, recuperar respuestas inciertas y conservar los intentos anteriores
// Nunca guardar tokens de tarjeta ni cuerpos de solicitudes o respuestas MP.
model OperacionCobro {
  id String @id @default(uuid())
  intentoId String @map("intento_id")
  intento IntentoCompra @relation(fields: [intentoId], references: [id], onDelete: Restrict)
  claveSolicitud String @unique @map("clave_solicitud")
  claveIdempotencia String @unique @map("clave_idempotencia")
  huellaSolicitud String @map("huella_solicitud")
  modoCaptura ModoCapturaOrders @default(automatic) @map("modo_captura")
  idOrdenExterna String? @unique @map("id_orden_externa")
  estado EstadoOperacionCobro @default(ENVIADA)
  estadoProveedor String? @map("estado_proveedor")
  creadoEn DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")
  @@index([intentoId, creadoEn])
  @@map("operaciones_cobro")
}
